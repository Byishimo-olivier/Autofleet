# Server Configuration
PORT=5000
NODE_ENV=development
FREE_ACCESS_MODE=true
PAYPACK_AUTO_SYNC=false

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=autofleet
ENABLE_POSTGRES_BOOTSTRAP=false

# Legacy PostgreSQL values are required only while running the migration command
# On Render, these are usually provided by the Internal Database URL
PGUSER=postgres
PGHOST=localhost
PGDATABASE=autofleet
PGPASSWORD=password
PGPORT=5432

# Authentication
JWT_SECRET=autofleet_secret_key_2024

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=AutoFleet Hub <noreply@autofleet.com>

# Client URL (Frontend)
CLIENT_URL=http://localhost:5173
